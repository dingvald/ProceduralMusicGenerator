    },
    {
      "id": "arp_pad",
      "type": "synth",
      "waveform": "square",
      "dutyCycle": 0.5,
      "arpeggio": { "semitones": [0, 4, 7, 12], "rateHz": 12 },
      "gain": 0.15,
      "envelope": { "attack": 0.03, "decay": 0.2, "sustain": 0.6, "release": 0.4 }
