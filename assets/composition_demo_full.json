      "type": "synth",
      "waveform": "square",
      "dutyCycle": 0.25,
      "gain": 0.32,
      "envelope": { "attack": 0.01, "decay": 0.12, "sustain": 0.55, "release": 0.2 }
    },
    {
      "id": "harmony_synth",
      "type": "synth",
      "waveform": "saw",
      "gain": 0.22,
      "envelope": { "attack": 0.02, "decay": 0.15, "sustain": 0.4, "release": 0.25 }
    },
    {
      "id": "bass_synth",
